<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111827">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Widget setup" android:textSize="18sp" android:textStyle="bold" android:textColor="#FFFFFF"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Panel URL" android:textSize="12sp" android:textColor="#9AA7BD" android:layout_marginTop="16dp"/>
        <EditText android:id="@+id/cfg_url" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textUri" android:textColor="#FFFFFF" android:background="#1f2937" android:padding="12dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Username" android:textSize="12sp" android:textColor="#9AA7BD" android:layout_marginTop="12dp"/>
        <EditText android:id="@+id/cfg_user" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="text" android:textColor="#FFFFFF" android:background="#1f2937" android:padding="12dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Password" android:textSize="12sp" android:textColor="#9AA7BD" android:layout_marginTop="12dp"/>
        <EditText android:id="@+id/cfg_pass" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textPassword" android:textColor="#FFFFFF" android:background="#1f2937" android:padding="12dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Unit (C or F)" android:textSize="12sp" android:textColor="#9AA7BD" android:layout_marginTop="12dp"/>
        <EditText android:id="@+id/cfg_unit" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="text" android:textColor="#FFFFFF" android:background="#1f2937" android:padding="12dp"
            android:text="C"/>

        <Button android:id="@+id/cfg_save" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Save" android:layout_marginTop="20dp" android:backgroundTint="#2563eb" android:textColor="#FFFFFF"/>
    </LinearLayout>
</ScrollView>
